# Configure values only in Vercel Environment Variables. Never commit real credentials.
#
# PREVIEW:
# - use only a homologation Supabase URL + publishable key;
# - do NOT define service-role, payment, cron, ERP-write, or logistics credentials.
#
# PRODUCTION:
# - use the production Supabase project and real server-only credentials;
# - secrets must never use a VITE_ prefix.

# Browser-safe Supabase settings. URL/key pair must belong to the same environment.
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_SITE_URL=https://www.balaclavaswsports.com.br
VITE_STANDALONE_AUTH=true

# Production-only privileged Supabase credential.
SUPABASE_SERVICE_ROLE_KEY=

# Runtime safety switch. Preview is blocked in code regardless of this value.
SWSPORTS_FINANCIAL_MAINTENANCE=false

# Production-only cron authentication.
CRON_SECRET=

# Production-only payment credentials.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Production-only Melhor Envio OAuth credentials.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://www.balaclavaswsports.com.br/api/melhor-envio/callback
MELHOR_ENVIO_ENVIRONMENT=production
MELHOR_ENVIO_OAUTH_STATE=

# SuperFrete runtime variables are intentionally absent. Historical records remain in the database.

# Manual migrations only; never run migrations during a website build.
DATABASE_URL=
